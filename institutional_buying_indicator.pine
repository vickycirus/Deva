//@version=5
indicator("Institutional Buying Detector - Indian Stocks", overlay=true, shorttitle="InstBuy")

// Input parameters
volume_threshold = input.float(2.0, "Volume Threshold (x Avg)", minval=1.0, maxval=10.0, step=0.1)
price_change_threshold = input.float(1.5, "Price Change Threshold (%)", minval=0.5, maxval=5.0, step=0.1)
rsi_oversold = input.int(30, "RSI Oversold Level", minval=20, maxval=40)
rsi_overbought = input.int(70, "RSI Overbought Level", minval=60, maxval=80)
macd_fast = input.int(12, "MACD Fast Length", minval=5, maxval=20)
macd_slow = input.int(26, "MACD Slow Length", minval=20, maxval=50)
macd_signal = input.int(9, "MACD Signal Length", minval=5, maxval=15)
sma_short = input.int(20, "Short SMA Length", minval=10, maxval=50)
sma_long = input.int(50, "Long SMA Length", minval=30, maxval=100)

// Calculate indicators
avg_volume = ta.sma(volume, 20)
volume_ratio = volume / avg_volume
price_change = ((close - close[1]) / close[1]) * 100
rsi = ta.rsi(close, 14)
[macd_line, signal_line, hist] = ta.macd(close, macd_fast, macd_slow, macd_signal)
sma_20 = ta.sma(close, sma_short)
sma_50 = ta.sma(close, sma_long)

// Volume analysis for institutional buying
high_volume = volume_ratio >= volume_threshold
price_up = price_change >= price_change_threshold
volume_price_confirmation = high_volume and price_up

// RSI conditions
rsi_bullish = rsi > rsi_oversold and rsi < rsi_overbought
rsi_oversold_bounce = rsi < rsi_oversold and rsi > rsi[1]

// MACD conditions
macd_bullish = macd_line > signal_line and hist > hist[1]
macd_crossover = ta.crossover(macd_line, signal_line)

// Moving average conditions
ma_bullish = close > sma_20 and sma_20 > sma_50
ma_crossover = ta.crossover(sma_20, sma_50)

// Additional institutional buying patterns
// 1. Gap up with volume
gap_up = open > high[1] and volume_ratio >= 1.5

// 2. Breakout above resistance with volume
resistance_break = close > high[1] and volume_ratio >= 2.0

// 3. Accumulation pattern (higher lows with increasing volume)
higher_low = low > low[1] and volume > volume[1]
accumulation = higher_low and close > open

// 4. Block trades detection (very high volume spikes)
block_trade = volume_ratio >= 5.0 and price_change > 0

// 5. Institutional support levels
support_bounce = low <= sma_50 and close > sma_50 and volume_ratio >= 1.5

// Composite institutional buying signal
institutional_buying = (
    volume_price_confirmation and
    (rsi_bullish or rsi_oversold_bounce) and
    (macd_bullish or macd_crossover) and
    (ma_bullish or ma_crossover)
) or
gap_up or
resistance_break or
(accumulation and volume_ratio >= 1.8) or
block_trade or
support_bounce

// Signal strength calculation
signal_strength = 0
signal_strength := signal_strength + (volume_price_confirmation ? 2 : 0)
signal_strength := signal_strength + (rsi_bullish ? 1 : 0)
signal_strength := signal_strength + (macd_bullish ? 1 : 0)
signal_strength := signal_strength + (ma_bullish ? 1 : 0)
signal_strength := signal_strength + (gap_up ? 3 : 0)
signal_strength := signal_strength + (resistance_break ? 3 : 0)
signal_strength := signal_strength + (block_trade ? 4 : 0)

// Plot signals
plotshape(
    institutional_buying and signal_strength >= 3,
    title="Strong Institutional Buy",
    location=location.belowbar,
    color=color.green,
    style=shape.triangleup,
    size=size.large,
    text="INST BUY"
)

plotshape(
    institutional_buying and signal_strength >= 2 and signal_strength < 3,
    title="Moderate Institutional Buy",
    location=location.belowbar,
    color=color.lime,
    style=shape.triangleup,
    size=size.normal,
    text="BUY"
)

// Plot moving averages
plot(sma_20, "SMA 20", color=color.blue, linewidth=2)
plot(sma_50, "SMA 50", color=color.red, linewidth=2)

// Volume bars coloring
barcolor(volume_ratio >= volume_threshold ? color.green : na, title="High Volume")

// Alert conditions
alertcondition(
    institutional_buying and signal_strength >= 4,
    title="Strong Institutional Buying Alert",
    message="Strong institutional buying detected! Volume: {{volume}}, Price Change: {{plot('Price Change')}}%, Signal Strength: {{plot('Signal Strength')}}"
)

alertcondition(
    institutional_buying and signal_strength >= 3,
    title="Institutional Buying Alert",
    message="Institutional buying detected! Volume: {{volume}}, Price Change: {{plot('Price Change')}}%"
)

// Display information
var table info_table = table.new(position.top_right, 2, 6, bgcolor=color.white, border_width=1)
if barstate.islast
    table.cell(info_table, 0, 0, "Volume Ratio", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 0, str.tostring(volume_ratio, "#.##"), text_color=color.black, bgcolor=color.gray)
    
    table.cell(info_table, 0, 1, "Price Change %", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 1, str.tostring(price_change, "#.##"), text_color=color.black, bgcolor=color.gray)
    
    table.cell(info_table, 0, 2, "RSI", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 2, str.tostring(rsi, "#.##"), text_color=color.black, bgcolor=color.gray)
    
    table.cell(info_table, 0, 3, "MACD", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 3, str.tostring(macd_line, "#.####"), text_color=color.black, bgcolor=color.gray)
    
    table.cell(info_table, 0, 4, "Signal Strength", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 4, str.tostring(signal_strength), text_color=color.black, bgcolor=color.gray)
    
    table.cell(info_table, 0, 5, "Status", text_color=color.black, bgcolor=color.gray)
    status_text = institutional_buying ? "BUY SIGNAL" : "NO SIGNAL"
    status_color = institutional_buying ? color.green : color.red
    table.cell(info_table, 1, 5, status_text, text_color=color.white, bgcolor=status_color)