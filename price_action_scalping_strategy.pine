//@version=5
strategy("Price Action Scalping Strategy", overlay=true, margin_long=100, margin_short=100, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================
// Timeframe settings
use_time_filter = input.bool(true, "Use Time Filter", group="Time Settings")
start_time = input.time(timestamp("2024-01-01T09:30:00"), "Start Time", group="Time Settings")
end_time = input.time(timestamp("2024-01-01T16:00:00"), "End Time", group="Time Settings")

// Moving averages for trend identification
ema_fast = input.int(8, "Fast EMA", minval=1, group="Moving Averages")
ema_slow = input.int(21, "Slow EMA", minval=1, group="Moving Averages")
ema_trend = input.int(50, "Trend EMA", minval=1, group="Moving Averages")

// RSI settings
rsi_length = input.int(14, "RSI Length", minval=1, group="RSI Settings")
rsi_oversold = input.int(30, "RSI Oversold", minval=0, maxval=100, group="RSI Settings")
rsi_overbought = input.int(70, "RSI Overbought", minval=0, maxval=100, group="RSI Settings")

// Volume settings
volume_ma_length = input.int(20, "Volume MA Length", minval=1, group="Volume Settings")
volume_threshold = input.float(1.5, "Volume Threshold Multiplier", minval=0.1, group="Volume Settings")

// Risk management
stop_loss_pips = input.float(10, "Stop Loss (Pips)", minval=1, group="Risk Management")
take_profit_pips = input.float(20, "Take Profit (Pips)", minval=1, group="Risk Management")
max_trades_per_day = input.int(5, "Max Trades Per Day", minval=1, group="Risk Management")

// ============================================================================
// CALCULATIONS
// ============================================================================
// Moving averages
ema_fast_val = ta.ema(close, ema_fast)
ema_slow_val = ta.ema(close, ema_slow)
ema_trend_val = ta.ema(close, ema_trend)

// RSI
rsi_val = ta.rsi(close, rsi_length)

// Volume analysis
volume_ma = ta.sma(volume, volume_ma_length)
volume_spike = volume > volume_ma * volume_threshold

// Price action patterns
body_size = math.abs(close - open)
upper_shadow = high - math.max(open, close)
lower_shadow = math.min(open, close) - low

// Doji pattern (small body, long shadows)
doji = body_size < (high - low) * 0.1 and (upper_shadow > body_size * 2 or lower_shadow > body_size * 2)

// Hammer pattern (long lower shadow, small upper shadow)
hammer = lower_shadow > body_size * 2 and upper_shadow < body_size * 0.5

// Shooting star pattern (long upper shadow, small lower shadow)
shooting_star = upper_shadow > body_size * 2 and lower_shadow < body_size * 0.5

// Engulfing patterns
bullish_engulfing = close > open and close > high[1] and open < low[1]
bearish_engulfing = close < open and close < low[1] and open > high[1]

// Pin bar patterns
pin_bar_bullish = lower_shadow > body_size * 2 and upper_shadow < body_size * 0.5 and close > open
pin_bar_bearish = upper_shadow > body_size * 2 and lower_shadow < body_size * 0.5 and close < open

// Support and resistance levels
pivot_high = ta.pivothigh(high, 5, 5)
pivot_low = ta.pivotlow(low, 5, 5)

// ============================================================================
// TREND ANALYSIS
// ============================================================================
// Trend direction
trend_up = ema_fast_val > ema_slow_val and ema_slow_val > ema_trend_val
trend_down = ema_fast_val < ema_slow_val and ema_slow_val < ema_trend_val

// Momentum
momentum_up = close > ema_fast_val and ema_fast_val > ema_fast_val[1]
momentum_down = close < ema_fast_val and ema_fast_val < ema_fast_val[1]

// ============================================================================
// ENTRY SIGNALS
// ============================================================================
// Long entry conditions
long_condition = false
long_condition := trend_up and momentum_up and rsi_val < rsi_overbought and volume_spike and (
    hammer or 
    bullish_engulfing or 
    pin_bar_bullish or
    (doji and close > ema_fast_val)
)

// Short entry conditions
short_condition = false
short_condition := trend_down and momentum_down and rsi_val > rsi_oversold and volume_spike and (
    shooting_star or 
    bearish_engulfing or 
    pin_bar_bearish or
    (doji and close < ema_fast_val)
)

// ============================================================================
// TIME FILTER
// ============================================================================
time_ok = true
if use_time_filter
    current_time = time
    time_ok := current_time >= start_time and current_time <= end_time

// ============================================================================
// TRADE MANAGEMENT
// ============================================================================
// Count trades per day
var int trades_today = 0
var int last_trade_day = 0

if dayofmonth != last_trade_day
    trades_today := 0
    last_trade_day := dayofmonth

// Check if we can trade
can_trade = trades_today < max_trades_per_day and time_ok

// ============================================================================
// STRATEGY EXECUTION
// ============================================================================
// Long entry
if long_condition and can_trade and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=close - stop_loss_pips * syminfo.mintick, limit=close + take_profit_pips * syminfo.mintick)
    trades_today := trades_today + 1

// Short entry
if short_condition and can_trade and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=close + stop_loss_pips * syminfo.mintick, limit=close - take_profit_pips * syminfo.mintick)
    trades_today := trades_today + 1

// ============================================================================
// PLOTTING
// ============================================================================
// Plot moving averages
plot(ema_fast_val, "Fast EMA", color=color.blue, linewidth=1)
plot(ema_slow_val, "Slow EMA", color=color.orange, linewidth=1)
plot(ema_trend_val, "Trend EMA", color=color.red, linewidth=2)

// Plot entry signals
plotshape(long_condition and can_trade, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short_condition and can_trade, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// Plot RSI levels on price chart
hline(rsi_overbought, "RSI Overbought", color=color.red, linestyle=hline.style_dashed)
hline(rsi_oversold, "RSI Oversold", color=color.green, linestyle=hline.style_dashed)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(long_condition and can_trade, "Long Entry Alert", "Price Action Scalping: Long Entry Signal")
alertcondition(short_condition and can_trade, "Short Entry Alert", "Price Action Scalping: Short Entry Signal")

// ============================================================================
// TABLE DISPLAY
// ============================================================================
if barstate.islast
    var table info_table = table.new(position.top_right, 2, 6, bgcolor=color.white, border_width=1)
    
    table.cell(info_table, 0, 0, "Strategy Info", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 0, "Price Action Scalping", text_color=color.black, bgcolor=color.gray)
    
    table.cell(info_table, 0, 1, "Trend", text_color=color.black)
    table.cell(info_table, 1, 1, trend_up ? "BULLISH" : trend_down ? "BEARISH" : "NEUTRAL", 
               text_color=trend_up ? color.green : trend_down ? color.red : color.orange)
    
    table.cell(info_table, 0, 2, "RSI", text_color=color.black)
    table.cell(info_table, 1, 2, str.tostring(math.round(rsi_val, 2)), 
               text_color=rsi_val > rsi_overbought ? color.red : rsi_val < rsi_oversold ? color.green : color.black)
    
    table.cell(info_table, 0, 3, "Volume Spike", text_color=color.black)
    table.cell(info_table, 1, 3, volume_spike ? "YES" : "NO", 
               text_color=volume_spike ? color.green : color.red)
    
    table.cell(info_table, 0, 4, "Trades Today", text_color=color.black)
    table.cell(info_table, 1, 4, str.tostring(trades_today) + "/" + str.tostring(max_trades_per_day), 
               text_color=trades_today < max_trades_per_day ? color.green : color.red)
    
    table.cell(info_table, 0, 5, "Can Trade", text_color=color.black)
    table.cell(info_table, 1, 5, can_trade ? "YES" : "NO", 
               text_color=can_trade ? color.green : color.red)